# Postgres (Neon). Each Vercel project uses its own database via DATABASE_URL.
# App runtime can use the pooled Neon URL. Migrations should use the direct URL.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/video_db
DATABASE_URL_UNPOOLED=

# Better Auth (same database as DATABASE_URL). Neon Auth is the hosted form of this;
# local and per-project deploys run Better Auth against that project's Postgres.
BETTER_AUTH_SECRET=replace-with-a-long-random-string
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_TRUSTED_ORIGINS=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Vercel Blob (replaces the Supabase Storage "videos" bucket)
BLOB_READ_WRITE_TOKEN=

# App URLs
NEXTAUTH_URL=http://localhost:3000
# Supplied automatically by the hosting platform when applicable
RENDER_EXTERNAL_URL=
VERCEL_URL=
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_MUSIC_LIBRARY=[]
FASTAPI_URL=http://localhost:8000
VIDEO_ASSEMBLY_URL=

# Content generation
OPENAI_API_KEY=sk-your-openai-key
OPENAI_CONTENT_MODEL=gpt-4o-mini
OPENAI_TTS_MODEL=gpt-4o-mini-tts
FAL_KEY=your_fal_key
PEXELS_API_KEY=
UNSPLASH_ACCESS_KEY=
MEDIA_GENERATION_CONCURRENCY=3
MAX_AI_VIDEO_SCENES=8
UNSPLASH_API_KEY=

# Audio generation
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# YouTube OAuth / uploads
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_ACCESS_TOKEN=
ENABLE_YOUTUBE_CAPTIONS=true

# Content pipeline CLI (npm run pipeline)
# YouTube Data API key for trend discovery (chart=mostPopular)
YOUTUBE_API_KEY=
# Offline refresh token for CLI publishing — obtain with: npm run pipeline -- auth
YOUTUBE_REFRESH_TOKEN=
# Read-only Drive import for motivation Shorts — obtain with: npm run pipeline -- drive-auth
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REFRESH_TOKEN=
# Shared Google OAuth credentials can be used instead of separate Drive credentials
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/api/uploads/youtube/callback
# Optional overrides
OPENAI_TTS_VOICE=alloy
FAL_IMAGE_MODEL=fal-ai/flux/dev
OPENAI_IMAGE_MODEL=gpt-image-1
PIPELINE_JOBS_DIR=
PIPELINE_AUTH_PORT=8787

# Scheduled uploads
CRON_SECRET=replace-with-a-long-random-string

# Billing
STRIPE_PRICE_ID_PRO=

# X / Twitter integrations
X_BEARER_TOKEN=
X_CONSUMER_KEY=
X_CONSUMER_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=
X_TREND_QUERY=

# Optional branding / assembly assets
BACKGROUND_MUSIC_URL=
BACKGROUND_MUSIC_PATH=
BACKGROUND_MUSIC_VOLUME=0.2
BRANDING_LOGO_URL=
BRANDING_LOGO_PATH=
BRANDING_LOGO_SCALE=0.12
BRANDING_LOGO_OPACITY=0.85
BRANDING_LOGO_POSITION=top-right
BRANDING_LOGO_PADDING=24

# Worker / API infrastructure (uses DATABASE_URL and BLOB_READ_WRITE_TOKEN above)
REDIS_URL=redis://localhost:6379
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=video_db
STORAGE_PATH=/app/storage/videos
STORAGE_PROVIDER=s3
DELETE_LOCAL_AFTER_UPLOAD=false

# Worker object storage (configure either S3 or R2)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET=
R2_ENDPOINT_URL=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
CDN_URL=
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_API_TOKEN=
